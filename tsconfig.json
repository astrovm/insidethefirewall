{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2024",
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tools/**/*.ts"]
}
